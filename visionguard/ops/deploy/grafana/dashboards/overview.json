{
 "title": "VisionGuard Overview",
 "uid": "vg-overview",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Camera up (0 = blind spot)",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": "Prometheus",
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "vg_camera_up",
     "legendFormat": "{{camera_id}}{{status}}{{state}}{{service}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "FPS per camera",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": "Prometheus",
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "vg_processing_fps",
     "legendFormat": "{{camera_id}}{{status}}{{state}}{{service}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Inference p95 (s)",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": "Prometheus",
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le,camera_id) (rate(vg_inference_seconds_bucket[5m])))",
     "legendFormat": "{{camera_id}}{{status}}{{state}}{{service}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Frames dropped / s",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": "Prometheus",
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (camera_id) (rate(vg_frames_dropped_total[5m]))",
     "legendFormat": "{{camera_id}}{{status}}{{state}}{{service}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Incidents by status",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": "Prometheus",
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "vg_incidents",
     "legendFormat": "{{camera_id}}{{status}}{{state}}{{service}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Oldest OPEN incident age",
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": "Prometheus",
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "vg_incident_oldest_open_age_seconds",
     "legendFormat": "{{camera_id}}{{status}}{{state}}{{service}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Outbox (dead must be 0)",
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "datasource": "Prometheus",
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "vg_incident_outbox",
     "legendFormat": "{{camera_id}}{{status}}{{state}}{{service}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Notifications by status (DEAD must be 0)",
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "datasource": "Prometheus",
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "vg_notifications",
     "legendFormat": "{{camera_id}}{{status}}{{state}}{{service}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Reviewer verdicts / 24h",
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "datasource": "Prometheus",
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (label) (increase(vg_review_labels_total[24h]))",
     "legendFormat": "{{camera_id}}{{status}}{{state}}{{service}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Gateway latency p95",
   "gridPos": {
    "x": 12,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "datasource": "Prometheus",
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le) (rate(vg_http_request_duration_seconds_bucket{service=\"gateway\"}[5m])))",
     "legendFormat": "{{camera_id}}{{status}}{{state}}{{service}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Gateway requests by status",
   "gridPos": {
    "x": 0,
    "y": 40,
    "w": 12,
    "h": 8
   },
   "datasource": "Prometheus",
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (status) (rate(vg_http_requests_total{service=\"gateway\"}[5m]))",
     "legendFormat": "{{camera_id}}{{status}}{{state}}{{service}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Agent: analyzed vs fallback",
   "gridPos": {
    "x": 12,
    "y": 40,
    "w": 12,
    "h": 8
   },
   "datasource": "Prometheus",
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "vg_agent_events_total",
     "legendFormat": "{{camera_id}}{{status}}{{state}}{{service}}",
     "refId": "A"
    }
   ]
  }
 ]
}